# Public frontend build settings. Empty endpoint uses the single-Render fallback.
VITE_API_BASE_URL=
VITE_SHARING_DISABLED=false
# Optional frontend/env.local for split deployment: https://<relay>.onrender.com
# No model API key: both verified ONNX files ship as public application assets.

# Relay production settings (set in Render; the provider supplies PORT).
NODE_ENV=production
PORT=10000
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
SERVE_WEB=false
ROOM_LIMIT=10
VIEWERS_PER_ROOM=2
ROOM_TTL_SECONDS=3600
PAIR_CODE_TTL_SECONDS=600
OWNER_GRACE_SECONDS=45
MAX_FRAME_BYTES=131072
PREVIEW_MAX_HZ=2
ROOM_EGRESS_BYTES=134217728
PROCESS_EGRESS_BYTES=268435456
# Optional local GPU worker. Leave unset to disable worker registration.
# Generate 32 random bytes as base64url; share ONLY with ignored .env.worker.
ROADLENS_WORKER_SECRET=
