# Copy to .env.worker. Generate a new 32-byte base64url secret locally.
# Set the SAME secret in the relay's ROADLENS_WORKER_SECRET environment.
# Never put this secret in frontend variables, URLs, or Git.
ROADLENS_RELAY_URL=wss://YOUR-RELAY.onrender.com/worker
ROADLENS_WORKER_SECRET=
ROADLENS_MODEL_MODE=balanced
ROADLENS_GPU_RUNTIME=pytorch_cuda
ROADLENS_GPU_DEVICE=0
ALLOW_WORKER_CPU_FALLBACK=false
ROADLENS_ALLOW_LOOPBACK=false
