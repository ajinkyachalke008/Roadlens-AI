{
  "name": "roadlens",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch backend/src/main.ts\" \"vite --config frontend/vite.config.ts\"",
    "build": "npm run assets:ort && npm run model:verify && npm run typecheck && npm run build:relay && vite build --config frontend/vite.config.ts",
    "start": "node dist/backend/src/main.js",
    "lint": "eslint frontend/src backend/src shared/src tests --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:model": "playwright test --config tests/model/playwright.config.ts",
    "test:privacy": "node scripts/check-no-persistence.mjs && node scripts/check-plate-privacy.mjs && playwright test --config playwright.config.ts --grep privacy",
    "smoke:cloud": "node scripts/smoke-cloud.mjs",
    "model:prepare": "node scripts/prepare-model.mjs",
    "model:verify": "node scripts/verify-model.mjs",
    "assets:ort": "node scripts/copy-ort-assets.mjs",
    "build:relay": "tsc -p backend/tsconfig.json",
    "deploy:verify": "node scripts/verify-deploy.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "smoke:frontend": "node scripts/smoke-frontend.mjs",
    "test:split-production": "node scripts/smoke-split.mjs",
    "test:gpu": "playwright test --config tests/gpu/playwright.config.ts",
    "test:start": "node tests/scripts/start-worker.mjs",
    "test:worker": "node scripts/worker-python.mjs -m pytest worker/tests -q",
    "gpu:benchmark": "node scripts/worker-python.mjs -m worker.runtime.benchmark",
    "plate:eval": "node scripts/worker-python.mjs training/plates/evaluate.py",
    "plate:ocr-bench": "node scripts/worker-python.mjs training/plates/ocr_bench.py",
    "plate:dataset": "node scripts/worker-python.mjs training/plates/openimages.py",
    "plate:train": "node scripts/worker-python.mjs training/plates/train_plate.py",
    "plate:benchmark": "node scripts/worker-python.mjs -m worker.runtime.plate_benchmark",
    "showcase:benchmark": "tsx scripts/showcase-benchmark.ts",
    "measure:production": "node scripts/measure-production.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "express": "5.2.1",
    "leaflet": "^1.9.4",
    "ml-matrix": "6.15.0",
    "onnxruntime-web": "1.29.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "license": "AGPL-3.0-only"
}
